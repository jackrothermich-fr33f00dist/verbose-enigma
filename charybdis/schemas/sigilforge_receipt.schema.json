{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "charybdis/sigilforge_receipt.schema.json",
  "title": "SigilForge Bundle Receipt",
  "type": "object",
  "required": ["schema_version", "request_id", "bundle_id", "completed_at", "identity", "status"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "request_id": { "type": "string", "format": "uuid" },
    "bundle_id": { "type": "string" },
    "completed_at": { "type": "string", "format": "date-time" },
    "identity": {
      "type": "object",
      "required": ["custody_id", "case_id"],
      "properties": {
        "custody_id": { "type": "string" },
        "case_id": { "type": "string" }
      }
    },
    "status": { "enum": ["success", "failed"] },
    "error": { "type": ["string", "null"] },
    "bundle": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "filename": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "format": { "enum": ["zip+gpg", "tar.gz+gpg", "custom"] }
      }
    },
    "encryption": {
      "type": "object",
      "properties": {
        "algorithm": { "const": "AES-256-GCM" },
        "key_id": { "type": "string" },
        "recipients": { "type": "array", "items": { "type": "string" } }
      }
    },
    "files_included": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "filename", "sha256_pre_encryption"],
        "properties": {
          "role": { "type": "string" },
          "filename": { "type": "string" },
          "sha256_pre_encryption": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
        }
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "bundle_sha256_confirmed": { "type": "boolean" },
        "all_input_hashes_verified": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "success" } } },
      "then": { "required": ["bundle", "encryption", "files_included", "verification"] }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } } },
      "then": { "required": ["error"], "properties": { "error": { "type": "string" } } }
    }
  ]
}
