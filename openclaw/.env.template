# OpenClaw Environment Variables
# Copy this to ~/.openclaw/.env on your WSL machine and fill in values.
# NEVER commit the filled-in version to git — this template is safe.

# ── Required ──────────────────────────────────────────────────────────────────

# Anthropic API key — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Gateway auth token — generate one with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=REPLACE_WITH_RANDOM_STRING

# ── Telegram (phone access) ───────────────────────────────────────────────────
# 1. Open Telegram → search @BotFather → /newbot → follow prompts → copy token
# 2. Paste it here:
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN

# Your personal Telegram user ID (for allowlist after pairing):
# 1. Message @userinfobot in Telegram — it replies with your numeric ID
# 2. Once you have it, add it to openclaw.json under channels.telegram.allowFrom
#    and switch dmPolicy to "allowlist"
# TELEGRAM_USER_ID=123456789
